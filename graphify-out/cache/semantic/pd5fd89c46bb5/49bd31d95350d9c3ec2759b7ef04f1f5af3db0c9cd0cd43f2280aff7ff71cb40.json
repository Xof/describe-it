{"nodes": [{"id": "docs_adr_0004_default_to_qwen35_4b", "label": "ADR 0004: Default to the qwen3.5:4b vision model", "file_type": "document", "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0004", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0004_default_to_qwen35_4b_qwen35_4b_default_model", "label": "qwen3.5:4b default model", "file_type": "rationale", "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen at sign-off (spec Q1) on character not benchmark: Alibaba, ~3 GB, vision+thinking (thinking disabled by us); Qwen models are generally less refusal-prone than Gemma, which matters for the NSFW use case. Resolved at Describer construction, not import time, so a long-lived process does not freeze the environment it started with. Addendum: Ollama 0.32.13 on the dev machine cannot load the qwen3.5:4b blob (CLIP rope.dimension_sections error), so live tests ran with llava:7b; default unchanged."}, {"id": "docs_adr_0004_default_to_qwen35_4b_gemma4_e4b", "label": "gemma4:e4b (alternative model)", "file_type": "concept", "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reportedly higher caption quality but more likely to refuse; lost because refusal resistance is what the NSFW use case needs. Unmeasured."}, {"id": "docs_adr_0004_default_to_qwen35_4b_llava_7b", "label": "llava:7b (model used in live runs)", "file_type": "concept", "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older, widely available, no thinking capability. In seven live runs it answered in English regardless of language and overran max_words in two of seven."}, {"id": "docs_adr_0004_default_to_qwen35_4b_describe_it_model_env_var", "label": "$DESCRIBE_IT_MODEL environment variable", "file_type": "concept", "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overrides the packaged default; read at describer construction (per call for describe()), never at import; blank counts as unset."}], "edges": [{"source": "docs_adr_0004_default_to_qwen35_4b", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_default_to_qwen35_4b", "target": "docs_adr_0004_default_to_qwen35_4b_qwen35_4b_default_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_default_to_qwen35_4b", "target": "docs_adr_0004_default_to_qwen35_4b_gemma4_e4b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_default_to_qwen35_4b", "target": "docs_adr_0004_default_to_qwen35_4b_llava_7b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_default_to_qwen35_4b", "target": "docs_adr_0004_default_to_qwen35_4b_describe_it_model_env_var", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-default-to-qwen35-4b.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_de