{"nodes": [{"id": "docs_adr_0014_validate_configuration_at_construction", "label": "ADR 0014: Validate configuration where it is written, not at the first request", "file_type": "document", "source_file": "docs/adr/0014-validate-configuration-at-construction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0014", "status": "Accepted", "date": "2026-08-20"}, {"id": "docs_adr_0014_validate_configuration_at_construction_construction_time_validation", "label": "Validate configuration at construction, not first request", "file_type": "rationale", "source_file": "docs/adr/0014-validate-configuration-at-construction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bad host let through would surface later as an unrelated-looking connection error or a request sent somewhere unintended. Each value is checked by the object that uses it: host by normalise_host in OllamaClient.__init__ (credentials, query, fragment, bad scheme, unreadable port, no hostname); timeout in OllamaClient (inf is a hang with extra steps, nan loses every comparison); model and max_words in Describer. The credentials message does not quote the host back so a password cannot reach a log. Passing client= skips the host/timeout checks. The CLI converts these into usage errors (exit 2)."}], "edges": [{"source": "docs_adr_0014_validate_configuration_at_construction", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0014-validate-configuration-at-construction.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0014_validate_configuration_at_construction", "target": "docs_adr_0014_validate_configuration_at_construction_construction_time_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 