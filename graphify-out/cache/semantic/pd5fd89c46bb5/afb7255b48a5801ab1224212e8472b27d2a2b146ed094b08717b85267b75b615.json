{"nodes": [{"id": "docs_adr_0001_use_a_local_ollama_vision_model", "label": "ADR 0001: Use a local Ollama vision model rather than a hosted description API", "file_type": "document", "source_file": "docs/adr/0001-use-a-local-ollama-vision-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0001", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0001_use_a_local_ollama_vision_model_ollama", "label": "Ollama (local model server)", "file_type": "concept", "source_file": "docs/adr/0001-use-a-local-ollama-vision-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_use_a_local_ollama_vision_model_local_ollama_inference", "label": "Local Ollama vision inference", "file_type": "rationale", "source_file": "docs/adr/0001-use-a-local-ollama-vision-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alt-text at volume is cheap locally and expensive via commercial APIs; the images may be NSFW, which hosted services refuse or penalise, and a local model has no policy layer beyond its weights. 'Local' is a default not a guarantee: https:// and paths survive host normalisation so a remote Ollama behind a reverse proxy works."}, {"id": "docs_adr_0001_use_a_local_ollama_vision_model_hosted_vision_api", "label": "Commercial hosted vision API (rejected)", "file_type": "concept", "source_file": "docs/adr/0001-use-a-local-ollama-vision-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected for per-image cost at volume and a content policy that rejects part of the corpus. Ollama's OpenAI-compatible endpoint and llama.cpp direct are also non-goals; rationale for those not recovered."}], "edges": [{"source": "docs_adr_0001_use_a_local_ollama_vision_model", "target": "d