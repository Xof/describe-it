{"nodes": [{"id": "docs_adr_0007_fix_the_sampling_options_for_a_caption", "label": "ADR 0007: Fix the sampling options for a caption call", "file_type": "document", "source_file": "docs/adr/0007-fix-the-sampling-options-for-a-caption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0007", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0007_fix_the_sampling_options_for_a_caption_sampling_options", "label": "Sampling options: temperature 0.2, num_predict = max_words*4+32", "file_type": "rationale", "source_file": "docs/adr/0007-fix-the-sampling-options-for-a-caption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not temperature 0: a few small models degenerate into repetition at exactly 0. num_predict is a safety stop, not the length control (the prompt is): four tokens per word is well above English's ~1.3 and the constant margin keeps max_words=1 from being cut off mid-sentence. Output is therefore not reproducible run to run."}], "edges": [{"source": "docs_adr_0007_fix_the_sampling_options_for_a_caption", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-fix-the-sampling-options-for-a-caption.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0007_fix_the_sampling_options_for_a_caption", "target": "docs_adr_0007_fix_the_sampling_options_for_a_caption_sampling_options", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-fix-the-sampling-options-for-a-caption.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0007_fix_the_sampling_options_for_a_caption", "target": "docs_adr_0006_clean_replies_to_a_fixed_point_no_truncation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou