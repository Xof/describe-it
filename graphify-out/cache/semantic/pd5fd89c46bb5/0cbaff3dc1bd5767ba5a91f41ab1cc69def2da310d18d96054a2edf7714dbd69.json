{"nodes": [{"id": "docs_adr_0008_build_a_private_urllib_opener", "label": "ADR 0008: Build a private urllib opener that ignores proxies and does not follow redirects", "file_type": "document", "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0008", "status": "Accepted", "date": "2026-08-20"}, {"id": "docs_adr_0008_build_a_private_urllib_opener_private_urllib_opener", "label": "Private OpenerDirector per client", "file_type": "rationale", "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both urllib module-level defaults are wrong for a localhost service, so each OllamaClient builds its own OpenerDirector with an empty ProxyHandler and no HTTPRedirectHandler. Found in unit-2 review; commit 24e3be2."}, {"id": "docs_adr_0008_build_a_private_urllib_opener_proxy_bypass", "label": "Ignore $http_proxy and friends", "file_type": "rationale", "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "urllib's proxy support exempts nothing, not even loopback, so a machine-wide corporate proxy captured http://localhost:11434 traffic that ollama itself sends direct. Consequence: an Ollama reachable only through a proxy cannot be reached."}, {"id": "docs_adr_0008_build_a_private_urllib_opener_no_redirect_following", "label": "Do not follow redirects", "file_type": "rationale", "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "urllib follows a 30x by rewriting a redirected POST into a body-less GET, so the image would silently not be sent. A 3xx is an OllamaResponseError naming the Location; a Location on any other status is ignored because error pages carry one too (calling a 500 a redirect would send its reader after it)."}], "edges": [{"source": "docs_adr_0008_build_a_private_urllib_opener", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_build_a_private_urllib_opener", "target": "docs_adr_0008_build_a_private_urllib_opener_private_urllib_opener", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_build_a_private_urllib_opener", "target": "docs_adr_0008_build_a_private_urllib_opener_proxy_bypass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_build_a_private_urllib_opener", "target": "docs_adr_0008_build_a_private_urllib_opener_no_redirect_following", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_build_a_private_urllib_opener_private_urllib_opener", "target": "docs_adr_0008_build_a_private_urllib_opener_proxy_bypass", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-build-a-private-urllib-opener.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_build_a_private_urllib_opener_private_urllib_opener", "target": "docs_adr_0008_build_a_private_urllib_opener_no_redirect_following", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "c