{"nodes": [{"id": "docs_adr_0006_clean_replies_to_a_fixed_point", "label": "ADR 0006: Clean the model's reply to a fixed point", "file_type": "document", "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0006", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0006_clean_replies_to_a_fixed_point_fixed_point_cleaning", "label": "Clean the reply to a fixed point", "file_type": "rationale", "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec 6.1 requires clean(clean(x)) == clean(x); one layer of decoration stripping is not idempotent because models stack decoration (**\"Alt text: ...\"**). Removes <think> blocks (including unclosed ones), labels, balanced quotes/emphasis/code fences with info strings, collapses whitespace; empty or marker-only result is DescriptionError. Pure, so it lives in prompt.py and is table-tested without a server."}, {"id": "docs_adr_0006_clean_replies_to_a_fixed_point_zero_width_edge_trimming", "label": "BOM and zero-width characters trimmed at edges only", "file_type": "rationale", "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interior ZWJ/ZWNJ/ZWSP are orthographically required by Persian, Urdu, Hindi, Sinhala, Malayalam, Thai and Khmer and hold emoji sequences together; a global strip corrupts them. Trimmed at leading/trailing edges of the text and of each decoration layer."}, {"id": "docs_adr_0006_clean_replies_to_a_fixed_point_balanced_wrapper_stripping", "label": "Wrapping pairs stripped only when balanced", "file_type": "rationale", "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interior must not contain the closing character again, so quoted text at both ends of a description survives; an apostrophe between two word characters (a child's drawing) is punctuation, not a closing quote. Fence info-string match is case-sensitive because '```Text on a wall.```' lost its first word."}, {"id": "docs_adr_0006_clean_replies_to_a_fixed_point_no_truncation", "label": "No sentence-level truncation of overruns", "file_type": "rationale", "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a model overruns max_words the text is returned as-is; the caller asked for alt text, not a truncated fragment. Length is requested via the prompt, never enforced."}], "edges": [{"source": "docs_adr_0006_clean_replies_to_a_fixed_point", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point", "target": "docs_adr_0006_clean_replies_to_a_fixed_point_fixed_point_cleaning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point", "target": "docs_adr_0006_clean_replies_to_a_fixed_point_zero_width_edge_trimming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point", "target": "docs_adr_0006_clean_replies_to_a_fixed_point_balanced_wrapper_stripping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point", "target": "docs_adr_0006_clean_replies_to_a_fixed_point_no_truncation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point_fixed_point_cleaning", "target": "src_describe_it_prompt_clean_response", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point_fixed_point_cleaning", "target": "src_describe_it_prompt_strip_decorations", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point_zero_width_edge_trimming", "target": "src_describe_it_prompt_trim_edges", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point_balanced_wrapper_stripping", "target": "src_describe_it_prompt_strip_wrapper", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0006-clean-replies-to-a-fixed-point.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_clean_replies_to_a_fixed_point_fixed_point_cleaning", "target": "src_describe_it_exceptions_descriptionerror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.