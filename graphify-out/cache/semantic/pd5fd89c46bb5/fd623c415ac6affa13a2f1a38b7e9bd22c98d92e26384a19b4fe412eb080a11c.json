white_rgb_jpeg_over_white_pipeline", "target": "src_describe_it_image_to_rgb", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0005-prepare-images-as-rgb-jpeg-over-white.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_prepare_images_as_rgb_jpeg_over_white_never_mutate_callers_image", "target": "src_describe_it_image_prepare_image", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-prepare-images-as-rgb-jpeg-over-white.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_prepare_images_as_rgb_jpeg_over_white", "target": "docs_adr_0003_image_in_string_out_failures_are_exceptions_caller_mistakes_standard_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-prepare-images-as-rgb-jpeg-over-white.md", "source_location": null, "weight": 1.0}], "hyperedges": []}