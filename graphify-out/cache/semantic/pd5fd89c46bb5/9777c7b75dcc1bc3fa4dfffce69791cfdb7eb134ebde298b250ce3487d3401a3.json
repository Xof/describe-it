{"nodes": [{"id": "docs_adr_0009_never_pull_a_model_implicitly", "label": "ADR 0009: Never pull a model implicitly", "file_type": "document", "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0009", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0009_never_pull_a_model_implicitly_explicit_model_pull", "label": "Explicit, opt-in model pull (ensure_model)", "file_type": "rationale", "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pulling may download gigabytes and blocks, so it never happens implicitly: a describe call on a missing model raises ModelNotFoundError naming 'ollama pull <model>'. ensure_model() POSTs /api/pull only if /api/show reports the model missing. A model absent upstream yields an NDJSON error line on a 200 and is an OllamaResponseError, not ModelNotFoundError (reserved for 'not present on this server')."}, {"id": "docs_adr_0009_never_pull_a_model_implicitly_startup_health_check", "label": "check() startup health check", "file_type": "concept", "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only counterpart to ensure_model: raises OllamaConnectionError if unreachable, ModelNotFoundError if absent, returns silently otherwise."}], "edges": [{"source": "docs_adr_0009_never_pull_a_model_implicitly", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly", "target": "docs_adr_0009_never_pull_a_model_implicitly_explicit_model_pull", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly", "target": "docs_adr_0009_never_pull_a_model_implicitly_startup_health_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly_explicit_model_pull", "target": "src_describe_it_describer_describer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly_startup_health_check", "target": "src_describe_it_describer_describer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly_explicit_model_pull", "target": "src_describe_it_exceptions_modelnotfounderror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly_explicit_model_pull", "target": "src_describe_it_exceptions_ollamaresponseerror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0009-never-pull-a-model-implicitly.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0009_never_pull_a_model_implicitly_startup_health_check", "target": "src_describe_it_exceptions_ollamaconnectionerror", "relation": "references", "confidence": "EXTRACTED", "c