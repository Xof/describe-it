{"nodes": [{"id": "docs_adr_0002_use_stdlib_urllib_as_the_transport", "label": "ADR 0002: Use stdlib urllib as the transport instead of the ollama client library", "file_type": "document", "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0002", "status": "Accepted", "date": "2026-08-19"}, {"id": "docs_adr_0002_use_stdlib_urllib_as_the_transport_stdlib_urllib_transport", "label": "stdlib urllib.request transport", "file_type": "rationale", "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The library makes three trivial JSON POSTs (/api/chat, /api/show, /api/pull). The official ollama client would add httpx + pydantic to a package whose only dependency is Pillow. Test fidelity is better: tests run against a real in-process http.server exercising the actual urllib path (404 bodies, malformed JSON, slow responses). Async is a non-goal; adescribe over asyncio.to_thread could come later."}, {"id": "docs_adr_0002_use_stdlib_urllib_as_the_transport_ollama_pypi_client", "label": "ollama PyPI client (rejected)", "file_type": "concept", "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: pulls in httpx and pydantic transitively, and mocks would replace the real HTTP path in tests."}, {"id": "docs_adr_0002_use_stdlib_urllib_as_the_transport_in_process_http_server_fixture", "label": "In-process http.server test fixture (fake Ollama)", "file_type": "concept", "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records requests and returns scripted responses so 404 bodies, malformed JSON, slow handlers, NDJSON pull streams and truncated Content-Length bodies are all exercised through the real urllib code path. Lives in tests/conftest.py."}], "edges": [{"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport", "target": "docs_adr_0002_use_stdlib_urllib_as_the_transport_stdlib_urllib_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport", "target": "docs_adr_0002_use_stdlib_urllib_as_the_transport_ollama_pypi_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport", "target": "docs_adr_0002_use_stdlib_urllib_as_the_transport_in_process_http_server_fixture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport_stdlib_urllib_transport", "target": "docs_adr_0002_use_stdlib_urllib_as_the_transport_ollama_pypi_client", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-use-stdlib-urllib-as-the-transport.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_use_stdlib_urllib_as_the_transport_stdlib_urllib_transpor