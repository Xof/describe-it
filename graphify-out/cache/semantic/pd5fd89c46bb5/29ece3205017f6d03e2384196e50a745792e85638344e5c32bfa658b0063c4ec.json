{"nodes": [{"id": "docs_adr_0011_send_think_false_unconditionally", "label": "ADR 0011: Send think:false unconditionally, without a capability probe", "file_type": "document", "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "adr_id": "0011", "status": "Accepted", "date": "2026-08-20"}, {"id": "docs_adr_0011_send_think_false_unconditionally_think_false_unconditional", "label": "think:false sent unconditionally", "file_type": "rationale", "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops thinking-capable models (qwen3.5, gemma4) burning seconds on hidden reasoning for a caption. Verified (commit b4ebab7) that Ollama 0.32 accepts the field from models that cannot think (llava:7b), so a capability probe would cost an /api/show round trip per description to learn nothing. Pinned to Ollama 0.32; a future rejection would reopen the spec's conditional. <think> blocks are still stripped belt-and-braces."}, {"id": "docs_adr_0011_send_think_false_unconditionally_capability_probe", "label": "/api/show thinking-capability probe (rejected)", "file_type": "concept", "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec's fallback if Ollama rejected think:false with a 400; the condition never arose and the probe would double the request count."}, {"id": "docs_adr_0011_send_think_false_unconditionally_keep_alive_omitted", "label": "keep_alive omitted when unset, never sent as null", "file_type": "rationale", "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null overrides the server's own default (5 minutes) instead of asking for it, so the key is left out of the body entirely when unset."}], "edges": [{"source": "docs_adr_0011_send_think_false_unconditionally", "target": "docs_superpowers_specs_2026_08_19_describe_it_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0011_send_think_false_unconditionally", "target": "docs_adr_0011_send_think_false_unconditionally_think_false_unconditional", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0011_send_think_false_unconditionally", "target": "docs_adr_0011_send_think_false_unconditionally_capability_probe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0011_send_think_false_unconditionally", "target": "docs_adr_0011_send_think_false_unconditionally_keep_alive_omitted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0011_send_think_false_unconditionally_think_false_unconditional", "target": "docs_adr_0011_send_think_false_unconditionally_capability_probe", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0011-send-think-false-unconditionally.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0011_send_think_false_unconditionally_think_false_unconditional", "target": "src_describe_it_client_ollamaclient", "relation": "rationale_for", "confidence": "EXTRACTED